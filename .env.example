# =============================================================================
# Urdu Audio Article Prototype - Environment Configuration
# Copy this file to `.env` and fill in real values.
# Never commit `.env` to version control.
# =============================================================================

# ---- OpenAI ----
# Required only when PIPELINE_PROVIDER_MODE=real
# Obtain from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: OpenAI organization / project IDs (only if you belong to multiple).
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=

# ---- Provider mode ----
# `fake` -> deterministic local providers, no API key required, used for tests
#           and offline experimentation.
# `real` -> calls the OpenAI API. Requires OPENAI_API_KEY and explicit
#           confirmation before paid runs.
PIPELINE_PROVIDER_MODE=fake

# ---- Budget controls (USD) ----
DEFAULT_BUDGET_USD=30
HARD_CAP_USD=60
COST_SAFETY_MARGIN=0.20

# ---- Chunking defaults ----
DEFAULT_CHUNK_LENGTH_SECONDS=300
DEFAULT_OVERLAP_SECONDS=60

# Maximum chunk file size (in megabytes) before the chunker will warn.
# OpenAI's Whisper / gpt-4o-transcribe upload limit is currently 25 MB per file.
MAX_CHUNK_MB=24

# ---- Accepted audio extensions ----
# Comma-separated list. Default expects `.mp3`. Add other formats as needed.
# All extensions are matched case-insensitively, with or without a leading dot.
ACCEPTED_AUDIO_EXTENSIONS=mp3,wav,m4a,flac,ogg,webm,mp4

# ---- Model roles ----
# These are configurable. Change them here without editing source code.
# Verify model availability at https://platform.openai.com/docs/models before
# enabling real-provider mode.
TRANSCRIPTION_MODEL=gpt-4o-transcribe
TRANSLATION_MODEL=gpt-5.5
ARTICLE_MODEL=gpt-5.5
RECONCILIATION_MODEL=gpt-5.5

# ---- Output / runtime ----
# Directory where every run's artifacts are saved.
OUTPUT_ROOT=runs

# Cache directory for stage outputs (used to skip duplicate paid calls).
CACHE_ROOT=.cache_pipeline

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Prompt version pinning (used for cache keys + manifests). Bump when prompts
# change in a way that should invalidate cached outputs.
PROMPT_VERSION=v1

# ---- Local metadata database ----
# Used by API/processor migrations and local persistence adapters.
DATABASE_URL=postgresql://urdu_pipeline:urdu_pipeline_local_password@localhost:5432/urdu_pipeline
