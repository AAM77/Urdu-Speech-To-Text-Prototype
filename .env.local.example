# Local API-backed development stack example.
# Copy to `.env.local` for local compose overrides. Do not commit `.env.local`.

COMPOSE_PROJECT_NAME=urdu-pipeline

# Placeholder API/runtime ports.
API_PORT=8000
REVERSE_PROXY_PORT=8080

# Application defaults for local fake-provider runs.
PIPELINE_PROVIDER_MODE=fake
OUTPUT_ROOT=/workspace/runs
CACHE_ROOT=/workspace/.cache_pipeline
LOG_LEVEL=INFO
PROMPT_VERSION=v1

# PostgreSQL metadata store.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=urdu_pipeline
POSTGRES_USER=urdu_pipeline
POSTGRES_PASSWORD=urdu_pipeline_local_password
DATABASE_URL=postgresql://urdu_pipeline:urdu_pipeline_local_password@postgres:5432/urdu_pipeline

# S3-compatible local object storage.
MINIO_ENDPOINT=http://minio:9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=urdu_pipeline
MINIO_ROOT_PASSWORD=urdu_pipeline_local_password
OBJECT_STORE_BUCKET=urdu-pipeline-local
OBJECT_STORE_REGION=local

# Local queue/cache service.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
